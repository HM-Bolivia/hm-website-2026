# Copy to backend.hcl (gitignored) and run: terraform init -backend-config=backend.hcl
# The state bucket must exist beforehand (create it once, with versioning enabled).
bucket       = "my-terraform-state-bucket"
key          = "hackmeeting2026/site.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3-native state locking, no DynamoDB table needed
